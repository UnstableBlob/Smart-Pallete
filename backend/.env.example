# Smart Palette Backend Environment Variables
# Copy this file to .env and fill in your values

# Groq API Key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# LLM model to use (llama-3.1-70b-versatile is recommended for free tier)
GROQ_MODEL=llama-3.1-70b-versatile

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true

# YOLO model settings
YOLO_MODEL_NAME=yolov8s-worldv2.pt
YOLO_CONFIDENCE_THRESHOLD=0.30
YOLO_MAX_IMAGE_SIZE_MB=10

# Database
DATABASE_URL=sqlite:///./smart_palette.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
